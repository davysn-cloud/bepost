# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/bepost?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# Instagram OAuth
INSTAGRAM_CLIENT_ID="your-instagram-app-id"
INSTAGRAM_CLIENT_SECRET="your-instagram-app-secret"
INSTAGRAM_REDIRECT_URI="http://localhost:3001/api/auth/instagram/callback"

# AWS S3 (opcional, usar storage local em desenvolvimento)
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_REGION="us-east-1"
AWS_BUCKET_NAME="bepost-uploads"
USE_LOCAL_STORAGE="true"

# Email (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-email-password"
EMAIL_FROM="BePost <noreply@bepost.com>"

# App Config
PORT="3001"
NODE_ENV="development"
API_URL="http://localhost:3001"
FRONTEND_URL="http://localhost:3000"

# Upload Config
MAX_FILE_SIZE="52428800"
ALLOWED_FILE_TYPES="image/jpeg,image/png,image/gif,video/mp4,video/quicktime"
